<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KernelSU" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.KernelSU.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/background_light</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_splash_default</item>
        <item name="postSplashScreenTheme">@style/Theme.KernelSU</item>
        <item name="android:windowSplashScreenBackground">@android:color/background_light</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_splash_default</item>
    </style>

    <style name="Theme.KernelSU.Starting.Geometry" parent="Theme.KernelSU.Starting">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_geometry</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_geometry</item>
    </style>

    <style name="Theme.KernelSU.Starting.KernelSU" parent="Theme.KernelSU.Starting">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
    </style>

    <style name="Theme.KernelSU.WebUI" parent="Theme.KernelSU">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
